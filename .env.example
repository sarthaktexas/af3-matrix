# Local-only (default): omit the three cloud variables; data goes to ./data/af3-matrix

# Vercel Blob + Supabase (set all three to enable cloud persistence on Vercel)
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# If those three are set but you want APIs to read ./data/af3-matrix instead (local files on disk):
# AF3_USE_LOCAL_STORAGE=1

# Optional: override local data directory (ignored when cloud env is set)
# AF3_DATA_DIR=data/af3-matrix
